---
import SplashScreen from '../components/SplashScreen.astro';

interface Props {
	title: string;
	description?: string;
	image?: string;
}

const { 
	title, 
	description = "Gampang Beres - Semua Tagihan & Isi Ulang dalam Satu Aplikasi!",
	image = "/images/logo/logo-nobg.webp"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://gampangberes.biz.id');
---

<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		
		<!-- Google Site Verification -->
		<meta name="google-site-verification" content="qyNKb8JxihJFR2oSR2UeuZ7Eyk_i1CPA4xf9WXliM20" />

		<!-- Canonical URL -->
		<link rel="canonical" href={canonicalURL} />
		
		<!-- Primary Meta Tags -->
		<title>{title}</title>
		<meta name="title" content={title} />
		<meta name="description" content={description} />
		<meta name="keywords" content="Gampang Beres, Aplikasi PPOB, Pulsa Murah, Bayar Tagihan, Agen Pulsa, Token Listrik, Top Up Game" />
		<meta name="author" content="Gampang Beres" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL(image, canonicalURL)} />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={new URL(image, canonicalURL)} />
		
		<!-- Performance Optimizations -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		
		<!-- API Connectivity Optimization -->
		<link rel="preconnect" href="https://api.gampangberes.biz.id" crossorigin>
		<link rel="dns-prefetch" href="https://api.gampangberes.biz.id">
		<link rel="preload" href="https://api.gampangberes.biz.id/api/app-status" as="fetch" crossorigin fetchpriority="high">
		
		<!-- Preload Critical Assets -->
		<link rel="preload" as="image" href="/images/logo/logo-nobg.webp" type="image/webp" fetchpriority="high">
		
		<!-- Optimized Font Loading -->
		<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
		<noscript>
			<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		</noscript>

		<style is:global>
			:root {
				--accent: 136, 58, 234;
				--accent-light: 224, 204, 250;
				--accent-dark: 49, 10, 101;
				--accent-gradient: linear-gradient(
					45deg,
					rgb(var(--accent)),
					rgb(var(--accent-light)) 30%,
					white 60%
				);
			}
			html {
				font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
				background: #FFFFFF;
				scroll-behavior: smooth;
			}
		</style>
	</head>
	<body class="antialiased text-slate-900">
		<SplashScreen />
		<slot />
	</body>
</html>
