---
import { Download } from 'lucide-astro';
import { getAppStatus } from '../lib/api';

const appStatus = await getAppStatus();
const downloadUrl = '/download';
const fileSize = appStatus?.file_size || '';
---

<section class="py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-primary rounded-[3rem] p-8 md:p-16 lg:p-24 text-center relative overflow-hidden shadow-2xl shadow-primary/40">
      <!-- Decoration -->
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -mr-32 -mt-32 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-64 h-64 bg-white/10 rounded-full -ml-32 -mb-32 blur-3xl"></div>
      
      <div class="relative z-10 max-w-2xl mx-auto">
        <h2 class="text-3xl sm:text-5xl font-extrabold text-white mb-8 leading-tight">
          Siap Mengatur Tagihan dan Untung Maksimal?
        </h2>
        <p class="text-xl text-white mb-12">
          Bergabunglah dengan ribuan pengguna lainnya yang telah beralih ke cara pembayaran yang lebih gampang dan beres.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a 
            id="bottom-download-link"
            href={downloadUrl} 
            class="flex items-center space-x-3 bg-white text-primary px-10 py-5 rounded-2xl text-xl font-bold transition-all transform md:hover:scale-105 active:scale-95 md:hover:shadow-xl"
          >
            <Download class="w-6 h-6 animate-bounce" />
            <span>Download APK Sekarang</span>
          </a>
        </div>
        <p class="mt-6 text-slate-100 text-sm font-medium">
          Mendukung Android 5.0 ke atas <span id="bottom-filesize-text" class={!fileSize ? 'hidden' : ''}>• Ukuran file {fileSize}</span>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { getAppStatus } from '../lib/api';

  async function updateBottomCTA() {
    try {
      const appStatus = await getAppStatus();
      if (appStatus) {
        if (appStatus.download_url) {
          const downloadLink = document.getElementById('bottom-download-link') as HTMLAnchorElement;
          if (downloadLink) downloadLink.href = appStatus.download_url;
        }
        
        if (appStatus.file_size) {
          const sizeText = document.getElementById('bottom-filesize-text');
          if (sizeText) {
            sizeText.textContent = `• Ukuran file ${appStatus.file_size}`;
            sizeText.classList.remove('hidden');
          }
        }
      }
    } catch (error) {
      console.error('Failed to update BottomCTA:', error);
    }
  }

  updateBottomCTA();
</script>
