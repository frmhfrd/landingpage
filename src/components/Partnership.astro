---
import { CheckCircle2, Users2, Store } from 'lucide-astro';
import { getAppStatus, formatCurrency } from '../lib/api';

const appStatus = await getAppStatus();
const whatsappUrl = appStatus?.contact_whatsapp || '#';
const minDepositReseller = formatCurrency(appStatus?.min_deposit_reseller) || 'Sesuai Ketentuan';
const minDepositAgen = formatCurrency(appStatus?.min_deposit_agen) || 'Sesuai Ketentuan';

const tiers = [
  {
    name: 'Reseller (Default)',
    icon: Store,
    description: 'Cocok untuk penggunaan pribadi atau warung kecil yang baru memulai.',
    features: [
      'Pendaftaran 100% Gratis',
      'Harga Dasar Murah',
      `Minimal Deposit ${minDepositReseller}`,
      'Bisa Bangun Downline',
    ],
    cta: 'Daftar Sekarang',
    link: '/download',
    highlight: false,
  },
  {
    name: 'Mitra Agen',
    icon: Users2,
    description: 'Untuk konter pulsa & bisnis besar yang membutuhkan harga wholesale.',
    features: [
      'Harga Wholesale (Termurah)',
      'Fitur Transfer Saldo',
      `Deposit Awal ${minDepositAgen}`,
      'Bisa Bangun Downline',
      'Prioritas CS Support',
    ],
    cta: 'Hubungi Sales',
    link: whatsappUrl,
    highlight: true,
  },
];
---

<section id="kemitraan" class="py-24 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-slate-900 mb-4">Pilih Kemitraan Sesuai Kebutuhanmu</h2>
      <p class="text-lg text-slate-600 max-w-2xl mx-auto">
        Kedua peran memiliki akses fitur lengkap, termasuk membangun jaringan downline sendiri.
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {tiers.map((tier) => (
        <div class={`relative p-8 lg:p-12 rounded-3xl transition-all duration-300 ${tier.highlight ? 'bg-primary text-white shadow-2xl shadow-primary/30 scale-105 z-10' : 'bg-white text-slate-900 border border-slate-100'}`}>
          <div class="flex items-center space-x-4 mb-6">
            <div class={`p-3 rounded-2xl ${tier.highlight ? 'bg-white/20' : 'bg-primary/10 text-primary'}`}>
              <tier.icon class="w-8 h-8" />
            </div>
            <h3 class="text-2xl font-bold">{tier.name}</h3>
          </div>
          
          <p class={`mb-8 ${tier.highlight ? 'text-white/80' : 'text-slate-600'}`}>
            {tier.description}
          </p>

          <ul class="space-y-4 mb-10">
            {tier.features.map((feature) => (
              <li class="flex items-center space-x-3">
                <CheckCircle2 class={`w-5 h-5 flex-shrink-0 ${tier.highlight ? 'text-white' : 'text-primary'}`} />
                <span class="font-medium">{feature}</span>
              </li>
            ))}
          </ul>

          <a 
            href={tier.link} 
            class={`block w-full text-center py-4 rounded-xl font-bold transition-all ${tier.highlight ? 'bg-white text-primary hover:bg-slate-100' : 'bg-primary text-white hover:bg-primary-dark shadow-lg shadow-primary/20'}`}
          >
            {tier.cta}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
