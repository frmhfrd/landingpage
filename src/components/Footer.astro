---
import { MessageCircle } from 'lucide-astro';
import { getAppStatus } from '../lib/api';

const year = new Date().getFullYear();
const appStatus = await getAppStatus();
const version = appStatus?.latest_version || '1.0.0-beta';
const isMaintenance = appStatus?.maintenance_mode || false;
const whatsappUrl = appStatus?.contact_whatsapp || '#';
---

<footer class="bg-slate-900 text-white pt-20 pb-10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
      <!-- Logo & Slogan -->
      <div class="lg:col-span-1">
        <div class="flex items-center space-x-2 mb-6">
          <img src="/images/logo/gampangberes nobg.png" alt="Gampang Beres Logo" class="h-10 w-auto brightness-0 invert" />
          <div class="text-2xl font-extrabold text-white">
            Gampang<span class="text-primary">Beres</span>
          </div>
        </div>
        <p class="text-slate-400 leading-relaxed mb-6">
          Bikin semua urusan pembayaran jadi gampang dan beres. Platform andalan untuk solusi digital Anda.
        </p>
        <a 
          href={whatsappUrl} 
          class="inline-flex items-center space-x-2 text-primary font-bold hover:text-white transition-colors"
        >
          <MessageCircle class="w-5 h-5" />
          <span>WhatsApp Customer Service</span>
        </a>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-lg font-bold mb-6">Menu</h4>
        <ul class="space-y-4 text-slate-400">
          <li><a href="#beranda" class="hover:text-primary transition-colors">Beranda</a></li>
          <li><a href="#fitur" class="hover:text-primary transition-colors">Fitur</a></li>
          <li><a href="#layanan" class="hover:text-primary transition-colors">Layanan</a></li>
          <li><a href="#kemitraan" class="hover:text-primary transition-colors">Kemitraan</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="text-lg font-bold mb-6">Bantuan & Legal</h4>
        <ul class="space-y-4 text-slate-400">
          <li><a href="#faq" class="hover:text-primary transition-colors">FAQ</a></li>
          <li><a href="/terms" class="hover:text-primary transition-colors">Syarat & Ketentuan</a></li>
          <li><a href="/privacy" class="hover:text-primary transition-colors">Kebijakan Privasi</a></li>
        </ul>
      </div>

      <!-- App Status -->
      <div>
        <h4 class="text-lg font-bold mb-6">Status Aplikasi</h4>
        <div class="bg-slate-800 p-4 rounded-xl">
          <div class="flex items-center space-x-3 mb-2">
            <div class={`w-2 h-2 rounded-full ${isMaintenance ? 'bg-yellow-500' : 'bg-green-500 animate-pulse'}`}></div>
            <span class="text-sm font-semibold">Server: {isMaintenance ? 'Maintenance' : 'Online'}</span>
          </div>
          <p class="text-xs text-slate-500">Versi: {version}</p>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-slate-500 font-medium">
      <p>© {year} Gampang Beres. All rights reserved.</p>
      <div class="flex items-center space-x-8">
        <span>Made with ❤️ for Indonesia</span>
      </div>
    </div>
  </div>
</footer>
