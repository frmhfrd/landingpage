---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getAppStatus } from '../lib/api';
import { Download, Info, CheckCircle2 } from 'lucide-astro';

const appStatus = await getAppStatus();
const downloadUrl = appStatus?.download_url || '#';
const version = appStatus?.latest_version || '';
const fileSize = appStatus?.file_size || '';
const message = appStatus?.message || '';
const changelog = appStatus?.changelog || null;

// Handle changelog if it's an object/array
// In some cases it's an object with version as key, e.g. {"1.0.0": ["fix bug"]}
// In other cases it's just an array of strings.
let changelogItems: string[] = [];
if (changelog) {
  if (Array.isArray(changelog)) {
    changelogItems = changelog;
  } else if (typeof changelog === 'object') {
    // If it's an object, we take all values and flatten them
    changelogItems = Object.values(changelog).flat().map(item => String(item));
  }
}
---

<Layout title="Download APK - Gampang Beres">
  <Navbar />
  <main class="pt-32 pb-20 bg-slate-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-[2.5rem] p-8 md:p-12 shadow-xl shadow-slate-200/60 border border-slate-100">
        <div class="text-center mb-12">
          <div class="w-20 h-20 bg-primary/10 text-primary rounded-3xl flex items-center justify-center mx-auto mb-6">
            <Download class="w-10 h-10" />
          </div>
          <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-4">Mempersiapkan Download...</h1>
          <p class="text-slate-600 text-lg">Download akan dimulai otomatis dalam beberapa detik.</p>
        </div>

        <!-- App Info Card -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <div class="bg-slate-50 rounded-3xl p-6 border border-slate-100">
            <div class="flex items-center space-x-3 mb-4 text-primary">
              <Info class="w-5 h-5" />
              <h2 class="font-bold">Informasi Versi</h2>
            </div>
            <div class="space-y-3">
              <div class="flex justify-between">
                <span class="text-slate-500">Versi Terbaru</span>
                <span id="latest-version" class="font-bold text-slate-900">{version || '-'}</span>
              </div>
              <div class="flex justify-between">
                <span class="text-slate-500">Ukuran File</span>
                <span id="file-size" class="font-bold text-slate-900">{fileSize || '-'}</span>
              </div>
              {message && (
                <div class="pt-2">
                  <p id="app-message" class="text-sm text-slate-600 italic">"{message}"</p>
                </div>
              )}
            </div>
          </div>

          <div class="bg-slate-50 rounded-3xl p-6 border border-slate-100">
            <div class="flex items-center space-x-3 mb-4 text-secondary">
              <CheckCircle2 class="w-5 h-5" />
              <h2 class="font-bold">Catatan Rilis</h2>
            </div>
            <ul id="changelog-list" class="space-y-2">
              {changelogItems.length > 0 ? (
                changelogItems.map((item) => (
                  <li class="text-sm text-slate-600 flex items-start space-x-2">
                    <span class="text-secondary mt-1">•</span>
                    <span>{item}</span>
                  </li>
                ))
              ) : (
                <li class="text-sm text-slate-500 italic">Data tidak tersedia</li>
              )}
            </ul>
          </div>
        </div>

        <div class="flex flex-col items-center space-y-6">
          <a 
            id="manual-download-link"
            href={downloadUrl}
            class="flex items-center space-x-3 bg-primary hover:bg-primary-dark text-white px-10 py-5 rounded-2xl text-xl font-bold transition-all transform hover:scale-105 shadow-xl shadow-primary/25"
          >
            <Download class="w-6 h-6" />
            <span>Klik di sini jika tidak terdownload</span>
          </a>
          
          <p class="text-slate-400 text-sm">
            Pastikan Anda mengizinkan instalasi dari "Sumber Tidak Dikenal" di pengaturan Android Anda.
          </p>
        </div>
      </div>
      
      <div class="mt-12 text-center">
        <a href="/" class="text-primary font-bold hover:underline">← Kembali ke Beranda</a>
      </div>
    </div>
  </main>
  <Footer />

  <script>
    import { getAppStatus } from '../lib/api';

    async function initDownload() {
      // Get the latest status from API on client-side to ensure it's always up-to-date
      try {
        const appStatus = await getAppStatus();
        if (appStatus) {
          const latestDownloadUrl = appStatus.download_url;
          const downloadLink = document.getElementById('manual-download-link') as HTMLAnchorElement;

          // Update UI with latest info if available
          if (appStatus.latest_version) {
            const versionEl = document.getElementById('latest-version');
            if (versionEl) versionEl.textContent = appStatus.latest_version;
          }
          if (appStatus.file_size) {
            const sizeEl = document.getElementById('file-size');
            if (sizeEl) sizeEl.textContent = appStatus.file_size;
          }

          if (latestDownloadUrl && latestDownloadUrl !== '#') {
            // Update the link href immediately
            if (downloadLink) {
              downloadLink.href = latestDownloadUrl;
            }

            // Start automatic download/redirection
            setTimeout(() => {
              window.location.href = latestDownloadUrl;
            }, 1000);
            return;
          }
        }
      } catch (error) {
        console.error('Failed to fetch latest app status on client:', error);
      }

      // Fallback: If client-side fetch fails, use the baked-in URL if it's not '#'
      const downloadLink = document.getElementById('manual-download-link') as HTMLAnchorElement;
      if (downloadLink && downloadLink.href && !downloadLink.href.endsWith('#')) {
        setTimeout(() => {
          window.location.href = downloadLink.href;
        }, 1500);
      }
    }

    // Run on page load
    initDownload();
  </script>
</Layout>
